{
  "name": "cafe-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @cafe/web --filter @cafe/admin --filter @cafe/api dev",
    "build": "corepack pnpm -r --if-present build",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:check": "gitleaks detect --source . --config .gitleaks.toml --no-git"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.29",
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
