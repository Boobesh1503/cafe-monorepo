NODE_ENV=development
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://cafe_app:REPLACE_WITH_GENERATED_APP_PASSWORD@localhost:5432/cafe?schema=public
DIRECT_URL=postgresql://cafe_migrator:REPLACE_WITH_GENERATED_MIGRATOR_PASSWORD@localhost:5432/cafe?schema=public
SHADOW_DATABASE_URL=postgresql://cafe_migrator:REPLACE_WITH_GENERATED_MIGRATOR_PASSWORD@localhost:5432/cafe_shadow?schema=public
REDIS_URL=redis://:REPLACE_WITH_GENERATED_REDIS_PASSWORD@localhost:6379
POSTGRES_BOOTSTRAP_USER=cafe_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_GENERATED_BOOTSTRAP_PASSWORD
DATABASE_MIGRATOR_PASSWORD=REPLACE_WITH_GENERATED_MIGRATOR_PASSWORD
DATABASE_APP_PASSWORD=REPLACE_WITH_GENERATED_APP_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_GENERATED_REDIS_PASSWORD
CACHE_TTL_SECONDS=300
JWT_ACCESS_SECRET=REPLACE_WITH_GENERATED_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_GENERATED_JWT_REFRESH_SECRET

# Email Service (Optional for development - defaults to mock logger if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Foodie Café <noreply@foodiecafe.com>"
